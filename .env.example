# ForgeHub backend
FORGEHUB_HOST=127.0.0.1
FORGEHUB_PORT=8484

# Execution backend: "direct" (pod/ComfyUI running) or "serverless" (RunPod endpoint)
FORGEHUB_EXECUTION_MODE=direct

# Direct mode — ComfyUI location
COMFYUI_HOST=localhost
COMFYUI_PORT=8188

# Serverless mode — RunPod endpoint
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# RUNPOD_POLL_INTERVAL=5
# RUNPOD_JOB_TIMEOUT=1800

# Local storage for serverless outputs/uploads
FORGEHUB_STORAGE_DIR=data/storage

# Workflow catalog dir (pairs of <name>.json + <name>.meta.json)
FORGEHUB_WORKFLOW_DIR=workflows

# Direct mode file paths (shared filesystem with ComfyUI)
COMFYUI_INPUT_DIR=/workspace/ComfyUI/input
COMFYUI_OUTPUT_DIR=/workspace/ComfyUI/output

# Optional chat/prompt-assist endpoint (a ComfyUI with QwenVL-Mod /qwenvl/chat).
# Empty in serverless mode = chat disabled.
FORGEHUB_CHAT_BASE_URL=

# Alternative: OpenAI-compatible endpoint for prompt assist (no ComfyUI needed).
# Ollama: http://localhost:11434/v1 — llama.cpp server: http://localhost:8080/v1
# FORGEHUB_CHAT_LLM_URL=http://localhost:11434/v1
# FORGEHUB_CHAT_LLM_MODEL=qwen3.5-9b-defiant
# FORGEHUB_CHAT_LLM_KEY=

# FORGEHUB_FRONTEND_DIR=forgehub-app/dist
