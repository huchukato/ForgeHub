# ForgeHub backend
FORGEHUB_HOST=127.0.0.1
FORGEHUB_PORT=8484

# RunPod serverless endpoint (jobs run on RunPod only — no local ComfyUI)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# RUNPOD_POLL_INTERVAL=5
# RUNPOD_JOB_TIMEOUT=1800

# Optional S3-compatible offload for large job outputs (>~10MB return as
# presigned URLs — RunPod drops results over ~20MB). For a RunPod network
# volume: endpoint = https://s3api-<datacenter>.runpod.io/, bucket = volume id,
# region = datacenter id lowercase, creds from console → S3 API Keys.
# RUNPOD_S3_ENDPOINT_URL=
# RUNPOD_S3_REGION=
# RUNPOD_S3_BUCKET=
# RUNPOD_S3_ACCESS_ID=
# RUNPOD_S3_ACCESS_SECRET=

# Local storage for serverless outputs/uploads
FORGEHUB_STORAGE_DIR=data/storage

# Workflow catalog dir (pairs of <name>.json + <name>.meta.json)
FORGEHUB_WORKFLOW_DIR=workflows

# Optional chat/prompt-assist: OpenAI-compatible endpoint (Ollama :11434/v1,
# llama.cpp :8080/v1, OpenRouter...). Empty = chat disabled.
# FORGEHUB_CHAT_LLM_URL=http://localhost:11434/v1
# FORGEHUB_CHAT_LLM_MODEL=qwen3.5-9b-defiant
# FORGEHUB_CHAT_LLM_KEY=

# Alternative: a QwenVL-Mod /qwenvl/chat endpoint (e.g. a running pod).
# FORGEHUB_CHAT_BASE_URL=

# FORGEHUB_FRONTEND_DIR=forgehub-app/dist
