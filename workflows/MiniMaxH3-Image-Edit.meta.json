{
  "id": "mmh3-image-edit",
  "name": "MiniMax H3 Image Edit",
  "category": "MiniMax H3",
  "description": "Image edit stills (MiniMax H3 Image INT8, 6 step, CFG 1, serverless) con enhancer QwenVL reference-aware",
  "handler": "mmh3",
  "remote_file": "MiniMaxH3-Image-Edit.json",
  "endpoint_id": "",
  "outputs": [
    "image"
  ],
  "parameters": [
    {
      "key": "prompt",
      "label": "Edit instruction + aspect ratio (es. 'change X, 16:9' o 'adaptive')",
      "type": "text",
      "target": "job",
      "wildcard_prefix": "mmh3/image-edit/"
    },
    {
      "key": "images",
      "label": "Source image",
      "type": "images",
      "target": "job"
    },
    {
      "key": "enhance",
      "label": "Enhancer QwenVL",
      "type": "bool",
      "target": "job",
      "default": true
    },
    {
      "key": "vl_preset",
      "label": "Enhancer preset",
      "type": "select",
      "target": "job",
      "default": "MiniMax › H3-Image Edit",
      "options": [
        "MiniMax › H3-Image Edit"
      ],
      "parent": "enhance"
    },
    {
      "key": "image_size",
      "label": "Resolution",
      "type": "select",
      "target": "job",
      "default": "2048x2048 (1:1)",
      "options": [
        "1024x1024 (1:1)",
        "1344x768 (16:9)",
        "768x1344 (9:16)",
        "1536x864 (16:9)",
        "864x1536 (9:16)",
        "2048x2048 (1:1)",
        "2304x1728 (4:3)",
        "2720x1536 (16:9)",
        "2912x2912 (1:1)",
        "3360x2496 (4:3)",
        "3840x2176 (16:9)",
        "4096x4096 (1:1)",
        "4736x3552 (4:3)",
        "5472x3072 (16:9)"
      ]
    }
  ],
  "endpoint_name": "MiniMax H3"
}
