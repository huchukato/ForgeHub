        "populate",
        "fixed",
        "reproduce"
      ]
    },
    {
      "key": "enhance",
      "label": "Enhancer QwenVL",
      "type": "bool",
      "target": "job",
      "default": true
    },
    {
      "key": "vl_preset",
      "label": "Enhancer preset",
      "type": "select",
      "target": "job",
      "default": "Qwen Image T2I",
