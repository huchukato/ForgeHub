      "key": "prompt",
      "label": "Prompt (wildcard __name__ o tag Pony)",
      "type": "text",
      "target": "job"
    },
    {
      "key": "512:mode",
      "label": "Wildcard mode",
      "type": "select",
      "target": "node",
      "default": "populate",
