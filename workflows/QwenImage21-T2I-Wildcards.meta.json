{
  "id": "qwen21-t2i",
  "name": "Qwen Image 2.1 Text to Image",
  "category": "image",
  "description": "Text\u2192image con wildcard Pony + enhancer QwenVL (Qwen Image 2.1 UC INT8, serverless)",
  "handler": "qwen21",
  "remote_file": "QwenImage21-T2I-Wildcards.json",
  "endpoint_id": "rm1dvsnh3gxlew",
  "outputs": [
    "image"
  ],
  "parameters": [
