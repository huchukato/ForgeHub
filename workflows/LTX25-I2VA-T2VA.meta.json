{
 "id": "ltx-i2va-t2va",
 "name": "LTX 2.5 I2VA / T2VA",
 "category": "video",
 "description": "Text or image → video + audio (LTX 2.5 22B distilled, 2-stage: base → 2x latent upscale → refine). With an image attached it runs I2V; without, T2V — both through the QwenVL enhancer",
 "handler": "ltx",
 "remote_file": "LTX25-I2VA-T2VA.json",
 "endpoint_id": "",
 "endpoint_name": "LTX 2.5",
 "outputs": [
  "video",
  "audio"
 ],
 "parameters": [
  {
   "key": "prompt",
   "label": "Prompt",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "ltx/"
  },
  {
   "key": "style",
   "label": "Video style",
   "type": "select",
   "target": "job",
   "default": "None",
   "options": [
    "None",
    "[MATCH IMG] - __ltx/style/matchimg__",
    "[CINEMATIC] - __ltx/style/cinematic__",
    "[LIVEACTION] - __ltx/style/liveaction__",
    "[ANIME2D] - __ltx/style/anime2d__",
    "[CG3D] - __ltx/style/cg3d__",
    "[CLAYMATION] - __ltx/style/claymation__",
    "[WATERCOLOR] - __ltx/style/watercolor__",
    "[VINTAGE] - __ltx/style/vintage__",
    "[PAPERCRAFT] - __ltx/style/papercraft__",
    "[COLLAGE] - __ltx/style/collage__",
    "[HANDDRAWN] - __ltx/style/handdrawn__",
    "[RANDOM] - __ltx/style__"
   ]
  },
  {
   "key": "images",
   "label": "Image (optional — omit for T2V)",
   "type": "images",
   "target": "job",
   "max": 1
  },
  {
   "key": "seconds",
   "label": "Duration / QwenVL preset",
   "type": "select",
   "target": "job",
   "default": "5",
   "options": [
    "5",
    "10",
    "20"
   ]
  },
  {
   "key": "image_size",
   "label": "Resolution",
   "type": "select",
   "target": "job",
   "default": "auto",
   "options": [
    "auto",
    "1312x736 (16:9)",
    "736x1312 (9:16)",
    "960x960 (1:1)",
    "1152x768 (3:2)",
    "768x1152 (2:3)"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset (I2V/T2V)",
   "type": "select",
   "target": "job",
   "default": "LTX › NSFW I2V",
   "options": [
    "LTX › NSFW I2V",
    "LTX › NSFW FL2VA",
    "LTX › NSFW Loop",
    "LTX › NSFW T2V"
   ],
   "parent": "enhance"
  },
  {
   "key": "upscale",
   "label": "Upscale",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "rife",
   "label": "RIFE 50fps (post)",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "latent_upscaler",
   "label": "Latent upscaler (stage 2)",
   "type": "select",
   "target": "job",
   "default": "spatial",
   "options": [
    "spatial",
    "temporal"
   ]
  },
  {
   "key": "upscale_model",
   "label": "Upscale model",
   "type": "select",
   "target": "job",
   "default": "2xLexicaRRDBNet",
   "options": [
    "2x-CGIMaster-v1",
    "2x-AnimeSharpV3",
    "2xLexicaRRDBNet",
    "2xLexicaRRDBNet_Sharp",
    "RealESRGAN_x2plus",
    "4xUltrasharp_4xUltrasharpV10",
    "4x-AnimeSharp",
    "4xNomos2_hq_dat2",
    "4xNomos2_otf_esrgan",
    "4xLSDIRplusC",
    "RealESRGAN_x4plus",
    "RealESRGAN_x4plus_anime_6B",
    "realesrgan-x4minus"
   ],
   "parent": "upscale"
  },
  {
   "key": "upscale_target",
   "label": "Upscale target",
   "type": "select",
   "target": "job",
   "default": "2K",
   "options": [
    "2x",
    "3x",
    "4x",
    "1080p",
    "2K",
    "4K",
    "custom"
   ],
   "parent": "upscale"
  },
  {
   "key": "407:format",
   "label": "Video format",
   "type": "select",
   "target": "node",
   "default": "video/h264-mp4",
   "options": [
    "video/h264-mp4",
    "video/hevc-mp4",
    "video/av1-webm",
    "video/webm",
    "image/gif",
    "image/webp"
   ]
  },
  {
   "key": "407:crf",
   "label": "Video quality (CRF, lower=better)",
   "type": "int",
   "target": "node",
   "default": 19
  }
 ]
}