{
  "id": "pimpmypony-facedet",
  "name": "PimpMyPony Face Detailer",
  "category": "image",
  "description": "Pony / Illustrious text-to-image with wildcards + YOLO/SAM face detailer pass (serverless)",
  "handler": "pony",
  "remote_file": "PimpMyPony-FaceDet.json",
  "endpoint_id": "rm1dvsnh3gxlew",
  "outputs": [
    "image"
  ],
  "parameters": [
    {
      "key": "prompt",
      "label": "Prompt (wildcard __name__ o tag Pony)",
      "type": "text",
      "target": "job",
      "wildcard_prefix": "pmp/"
    },
    {
      "key": "82:mode",
      "label": "Wildcard mode",
      "type": "select",
      "target": "node",
      "default": "populate",
      "options": [
        "populate",
        "fixed",
        "reproduce"
      ]
    },
    {
      "key": "82:base_model",
      "label": "Wildcard preset",
      "type": "select",
      "target": "node",
      "default": "Pony",
      "options": [
        "None",
        "Pony",
        "Illustrious"
      ]
    },
    {
      "key": "92:131:ckpt_name",
      "label": "Checkpoint",
      "type": "select",
      "target": "node",
      "default": "pimpmypony_pmpInCaseEnhanced.safetensors",
      "options": [
        "pimpmypony_pmpInCaseEnhanced.safetensors",
        "ilustmix_v111.safetensors",
        "pimpmypony_pmpIncaseStyle.safetensors"
      ]
    },
    {
      "key": "92:131:resolution",
      "label": "Image size",
      "type": "select",
      "target": "node",
      "default": "896 x 1152",
      "options": [
        "1024 x 1024",
        "1152 x 896",
        "896 x 1152",
        "1216 x 832",
        "832 x 1216",
        "1344 x 768",
        "768 x 1344"
      ]
    },
    {
      "key": "92:132:steps",
      "label": "Steps",
      "type": "int",
      "target": "node",
      "default": 30
    },
    {
      "key": "92:132:cfg",
      "label": "CFG",
      "type": "float",
      "target": "node",
      "default": 6
    },
    {
      "key": "92:132:sampler_name",
      "label": "Sampler",
      "type": "select",
      "target": "node",
      "default": "euler_ancestral",
      "options": [
        "dpmpp_2m_sde",
        "dpmpp_2m",
        "dpmpp_3m_sde",
        "euler",
        "euler_ancestral"
      ]
    },
    {
      "key": "92:132:scheduler",
      "label": "Scheduler",
      "type": "select",
      "target": "node",
      "default": "karras",
      "options": [
        "karras",
        "normal",
        "exponential",
        "simple",
        "sgm_uniform"
      ]
    },
    {
      "key": "92:135:denoise",
      "label": "Detailer denoise",
      "type": "float",
      "target": "node",
      "default": 0.35
    },
    {
      "key": "92:135:steps",
      "label": "Detailer steps",
      "type": "int",
      "target": "node",
      "default": 20
    },
    {
      "key": "92:133:bbox_threshold",
      "label": "Face detect threshold",
      "type": "float",
      "target": "node",
      "default": 0.5
    }
  ]
}