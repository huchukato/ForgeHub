{
 "id": "qwen21-edit",
 "name": "Qwen Image 2.1 Edit",
 "category": "image",
 "description": "Image edit / character sheet (Qwen Image 2.1 UC INT8, serverless)",
 "handler": "qwen21",
 "remote_file": "QwenImageEdit21-Wildcards.json",
 "endpoint_id": "",
 "outputs": [
  "image"
 ],
 "parameters": [
  {
   "key": "prompt",
   "label": "Edit instruction",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "qwen21/"
  },
  {
   "key": "images",
   "label": "Images (base + reference)",
   "type": "images",
   "target": "job",
   "max": 2
  },
  {
   "key": "512:mode",
   "label": "Wildcard mode",
   "type": "select",
   "target": "node",
   "default": "populate",
   "options": [
    "populate",
    "fixed",
    "reproduce"
   ]
  },
  {
   "key": "camera_tag",
   "label": "Camera tag",
   "type": "select",
   "target": "job",
   "default": "None",
