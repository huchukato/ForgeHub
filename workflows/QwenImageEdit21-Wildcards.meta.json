    "1344x768",
    "1536x864",
    "1920x1088",
    "2048x1152",
    "1152x864",
    "1440x1088",
    "2048x1536",
    "768x1344",
    "864x1536",
    "1088x1920",
    "1152x2048",
    "864x1152",
    "1088x1440",
    "1536x2048",
    "768x1152",
    "832x1248",
    "1344x2016",
    "1152x768",
    "1248x832",
    "2016x1344",
    "1536x640",
    "2016x864",
    "2528x1088",
    "640x1536",
    "1280x720",
    "720x1280"
   ]
  },
  {
   "key": "resolution",
   "label": "Encoder resolution",
   "type": "select",
   "target": "job",
   "default": "1024",
   "options": [
    "1024",
    "1536",
    "2048"
   ]
