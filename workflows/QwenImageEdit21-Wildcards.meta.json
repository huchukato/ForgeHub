    "None",
    "[STATIC_CAMERA]",
    "[LOCKED_OFF]",
    "[SLOW_ZOOM_IN]",
    "[SLOW_ZOOM_OUT]",
    "[FAST_ZOOM_IN]",
    "[FAST_ZOOM_OUT]",
    "[PAN_LEFT]",
    "[PAN_RIGHT]",
    "[TILT_UP]",
    "[TILT_DOWN]",
    "[DOLLY_IN]",
    "[DOLLY_OUT]",
    "[TRACKING_LEFT]",
    "[TRACKING_RIGHT]",
    "[CRANE_UP]",
    "[CRANE_DOWN]",
    "[ORBIT]",
    "[HANDHELD]",
    "[ROLL]"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": false
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset",
   "type": "select",
   "target": "job",
   "default": "IMG \u203a Qwen Edit",
