      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "target": "job",
      "wildcard_prefix": "vid/"
    },
    {
      "key": "seconds",
      "label": "Duration / QwenVL preset",
      "type": "select",
      "target": "job",
      "default": "5",
      "options": [
        "5",
        "10",
        "15"
      ]
    },
    {
      "key": "config",
      "label": "Preset",
      "type": "select",
      "target": "job",
      "default": "native_turbo",
      "options": [
        "native",
        "native_turbo",
        "r2va_native",
        "r2va_native_turbo",
        "10eros",
        "10eros_turbo"
      ]
