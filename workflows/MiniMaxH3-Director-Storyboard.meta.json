{
 "id": "mmh3-director-storyboard",
 "name": "MiniMax H3 Director Storyboard",
 "category": "video",
 "description": "One prompt + up to 3 storyboard frames (pre-generated in Qwen 2.1 with the IMG › Storyboard preset) → video with audio: the in-graph QwenVL turns the idea into a full R2VA prompt",
 "handler": "mmh3",
 "remote_file": "MiniMaxH3-Director-Storyboard.json",
 "endpoint_id": "",
 "outputs": [
  "video",
  "audio"
 ],
 "parameters": [
  {
   "key": "images",
   "label": "Storyboard frames (up to 3 — generated in Qwen 2.1)",
   "type": "images",
   "target": "job",
   "max": 3
  },
  {
   "key": "prompt",
   "label": "Idea (scenes with timestamps, one per line)",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "mmh3/",
   "default": "3 scenes in 10 seconds, one per still, in order:\nat 00:00 (S1) is in the villa living room at sunset — warm golden light from the glass wall, standing by the window, serene composed gaze; the scene opens exactly on still 1\nat 00:04 (S1) walks along the garden colonnade in the morning — crisp cool light, decisive pace, light wind on her long hair\nat 00:08 (S1) indoors at night — blue moonlight from the large window, close-up, determined gaze\nCinematic light, (S1) identity identical in every scene. No dialogue."
  },
  {
   "key": "style",
   "label": "Video style",
   "type": "select",
   "target": "prompt",
   "prepend": true,
   "default": "None",
   "options": [
    "None",
    "[MATCH REF1] - STYLE: __mmh3/style/matchref1__",
    "[MATCH REF2] - STYLE: __mmh3/style/matchref2__",
    "[CINEMATIC] - STYLE: __mmh3/style/cinematic__",
    "[LIVEACTION] - STYLE: __mmh3/style/liveaction__",
    "[ANIME2D] - STYLE: __mmh3/style/anime2d__",
    "[CG3D] - STYLE: __mmh3/style/cg3d__",
    "[CLAYMATION] - STYLE: __mmh3/style/claymation__",
    "[WATERCOLOR] - STYLE: __mmh3/style/watercolor__",
    "[VINTAGE] - STYLE: __mmh3/style/vintage__",
    "[PAPERCRAFT] - STYLE: __mmh3/style/papercraft__",
    "[COLLAGE] - STYLE: __mmh3/style/collage__",
    "[HANDDRAWN] - STYLE: __mmh3/style/handdrawn__",
    "[RANDOM] - STYLE: __mmh3/style__"
   ]
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset",
   "type": "select",
   "target": "job",
   "default": "MiniMax › Director Storyboard",
   "options": [
    "MiniMax › Director Storyboard",
    "MiniMax › Director Prose"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "seconds",
   "label": "Duration",
   "type": "select",
   "target": "job",
   "default": "10",
   "options": [
    "5",
    "10",
    "15"
   ]
  },
  {
   "key": "config",
   "label": "Preset (sampler/turbo LoRA)",
   "type": "select",
   "target": "job",
   "default": "r2va_singularity_turbo",
   "options": [
    "r2va_singularity",
    "r2va_singularity_turbo"
   ]
  },
  {
   "key": "image_size",
   "label": "Resolution",
   "type": "select",
   "target": "job",
   "default": "auto (segue le still)",
   "options": [
    "auto (segue le still)",
    "1344x768 (16:9)",
    "768x1344 (9:16)",
    "1184x864 (4:3)",
    "864x1184 (3:4)",
    "1024x1024 (1:1)",
    "1536x672 (21:9)"
   ]
  },
  {
   "key": "upscale",
   "label": "Upscale",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "upscale_model",
   "label": "Upscale model",
   "type": "select",
   "target": "job",
   "default": "2xLexicaRRDBNet",
   "options": [
    "2x-CGIMaster-v1",
    "2x-AnimeSharpV3",
    "2xLexicaRRDBNet",
    "2xLexicaRRDBNet_Sharp",
    "RealESRGAN_x2plus",
    "4xUltrasharp_4xUltrasharpV10",
    "4x-AnimeSharp",
    "4xNomos2_hq_dat2",
    "4xNomos2_otf_esrgan",
    "4xLSDIRplusC",
    "RealESRGAN_x4plus",
    "RealESRGAN_x4plus_anime_6B",
    "realesrgan-x4minus"
   ],
   "parent": "upscale"
  },
  {
   "key": "upscale_target",
   "label": "Upscale target",
   "type": "select",
   "target": "job",
   "default": "2K",
   "options": [
    "2x",
    "3x",
    "4x",
    "1080p",
    "2K",
    "4K",
    "custom"
   ],
   "parent": "upscale"
  },
  {
   "key": "rife",
   "label": "RIFE 48fps (post)",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "14:format",
   "label": "Video format",
   "type": "select",
   "target": "node",
   "default": "auto",
   "options": [
    "auto",
    "video/h264-mp4",
    "video/hevc-mp4",
    "video/av1-webm",
    "video/webm"
   ]
  }
 ],
 "endpoint_name": "MiniMax H3"
}