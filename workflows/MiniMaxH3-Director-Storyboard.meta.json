{
 "id": "mmh3-director-storyboard",
 "name": "MiniMax H3 Director Storyboard",
 "category": "video",
 "description": "Un prompt (+ fino a 3 still pre-generate in Qwen 2.1) → video con audio: il QwenVL nel grafo trasforma l'idea in prompt R2VA completo",
 "handler": "mmh3",
 "remote_file": "MiniMaxH3-Director-Storyboard.json",
 "endpoint_id": "",
 "outputs": [
  "video",
  "audio"
 ],
 "parameters": [
  {
   "key": "images",
   "label": "Character sheet / stills (up to 3)",
   "type": "images",
   "target": "job",
   "max": 3
  },
  {
   "key": "prompt",
   "label": "Idea (scenes with timestamps, one per line)",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "mmh3/",
   "default": "3 scenes in 10 seconds, one per still, in order:\nat 00:00 (S1) is in the villa living room at sunset — warm golden light from the glass wall, standing by the window, serene composed gaze; the scene opens exactly on still 1\nat 00:04 (S1) walks along the garden colonnade in the morning — crisp cool light, decisive pace, light wind on her long hair\nat 00:08 (S1) indoors at night — blue moonlight from the large window, close-up, determined gaze\nCinematic light, (S1) identity identical in every scene. No dialogue."
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset",
   "type": "select",
   "target": "job",
   "default": "MiniMax › Director Storyboard",
   "options": [
    "MiniMax › Director Storyboard",
    "MiniMax › Director Prose"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "seconds",
   "label": "Duration",
   "type": "select",
   "target": "job",
   "default": "10",
   "options": [
    "5",
    "10",
    "15"
   ]
  },
  {
   "key": "image_size",
   "label": "Resolution (MMH3 native presets)",
   "type": "select",
   "target": "job",
   "default": "auto (segue le still)",
   "options": [
    "auto (segue le still)",
    "1344x768 (16:9)",
    "768x1344 (9:16)",
    "1184x864 (4:3)",
    "864x1184 (3:4)",
    "1024x1024 (1:1)",
    "1536x672 (21:9)"
   ]
  },
  {
   "key": "upscale",
   "label": "Upscale",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "upscale_model",
   "label": "Upscale model",
   "type": "select",
   "target": "job",
   "default": "2xLexicaRRDBNet",
   "options": [
    "2x-CGIMaster-v1",
    "2x-AnimeSharpV3",
    "2xLexicaRRDBNet",
    "2xLexicaRRDBNet_Sharp",
    "RealESRGAN_x2plus",
    "4xUltrasharp_4xUltrasharpV10",
    "4x-AnimeSharp",
    "4xNomos2_hq_dat2",
    "4xNomos2_otf_esrgan",
    "4xLSDIRplusC",
    "RealESRGAN_x4plus",
    "RealESRGAN_x4plus_anime_6B",
    "realesrgan-x4minus"
   ],
   "parent": "upscale"
  },
  {
   "key": "upscale_target",
   "label": "Upscale target",
   "type": "select",
   "target": "job",
   "default": "2K",
   "options": [
    "2x",
    "3x",
    "4x",
    "1080p",
    "2K",
    "4K",
    "custom"
   ],
   "parent": "upscale"
  },
  {
   "key": "rife",
   "label": "RIFE 48fps (post)",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "14:format",
   "label": "Video format",
   "type": "select",
   "target": "node",
   "default": "auto",
   "options": [
    "auto",
    "video/h264-mp4",
    "video/hevc-mp4",
    "video/av1-webm",
    "video/webm"
   ]
  }
 ],
 "endpoint_name": "MiniMax H3"
}