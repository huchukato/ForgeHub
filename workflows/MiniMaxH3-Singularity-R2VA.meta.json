{
 "id": "mmh3-singularity-r2va",
 "name": "MiniMax H3 Singularity R2VA",
 "category": "video",
 "description": "Reference → video con audio (Singularity fusion, serverless INT8)",
 "handler": "mmh3",
 "remote_file": "MiniMaxH3-Singularity-R2VA.json",
 "endpoint_id": "",
 "outputs": [
  "video",
  "audio"
 ],
 "parameters": [
  {
   "key": "prompt",
   "label": "Prompt",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "mmh3/",
   "default": ""
  },
  {
   "key": "style",
   "label": "Video style",
   "type": "select",
   "target": "prompt",
   "prepend": true,
   "default": "None",
   "options": [
    "None",
    "[MATCH REF1] - STYLE: __mmh3/style/matchref1__",
    "[MATCH REF2] - STYLE: __mmh3/style/matchref2__",
    "[CINEMATIC] - STYLE: __mmh3/style/cinematic__",
    "[LIVEACTION] - STYLE: __mmh3/style/liveaction__",
    "[ANIME2D] - STYLE: __mmh3/style/anime2d__",
    "[CG3D] - STYLE: __mmh3/style/cg3d__",
    "[CLAYMATION] - STYLE: __mmh3/style/claymation__",
    "[WATERCOLOR] - STYLE: __mmh3/style/watercolor__",
    "[VINTAGE] - STYLE: __mmh3/style/vintage__",
    "[PAPERCRAFT] - STYLE: __mmh3/style/papercraft__",
    "[COLLAGE] - STYLE: __mmh3/style/collage__",
    "[HANDDRAWN] - STYLE: __mmh3/style/handdrawn__",
    "[RANDOM] - STYLE: __mmh3/style__"
   ]
  },
  {
   "key": "images",
   "label": "Reference images (max 3)",
   "type": "images",
   "target": "job",
   "max": 3
  },
  {
   "key": "video",
   "label": "Reference video (optional)",
   "type": "video",
   "target": "job"
  },
  {
   "key": "lora",
   "label": "Style LoRA",
   "type": "select",
   "target": "job",
   "default": "none",
   "options": [
    "none",
    "realism",
    "char_swap"
   ]
  },
  {
   "key": "seconds",
   "label": "Duration / QwenVL preset",
   "type": "select",
   "target": "job",
   "default": "5",
   "options": [
    "5",
    "10",
    "15"
   ]
  },
  {
   "key": "image_size",
   "label": "Resolution",
   "type": "select",
   "target": "job",
   "default": "auto (segue l'aspect dell'immagine)",
   "options": [
    "auto (segue l'aspect dell'immagine)",
    "1344x768 (16:9)",
    "768x1344 (9:16)",
    "1184x864 (4:3)",
    "864x1184 (3:4)",
    "1024x1024 (1:1)",
    "1536x672 (21:9)"
   ]
  },
  {
   "key": "config",
   "label": "Preset",
   "type": "select",
   "target": "job",
   "default": "r2va_singularity_turbo",
   "options": [
    "native",
    "native_turbo",
    "r2va_singularity",
    "r2va_singularity_turbo",
    "10eros",
    "10eros_turbo"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset",
   "type": "select",
   "target": "job",
   "default": "MiniMax › NSFW R2VA",
   "options": [
    "MiniMax › NSFW R2VA",
    "MiniMax › SFW R2VA"
   ],
   "parent": "enhance"
  },
  {
   "key": "upscale",
   "label": "Upscale",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "rife",
   "label": "RIFE 48fps (post)",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "upscale_model",
   "label": "Upscale model",
   "type": "select",
   "target": "job",
   "default": "2xLexicaRRDBNet",
   "options": [
    "2x-CGIMaster-v1",
    "2x-AnimeSharpV3",
    "2xLexicaRRDBNet",
    "2xLexicaRRDBNet_Sharp",
    "RealESRGAN_x2plus",
    "4xUltrasharp_4xUltrasharpV10",
    "4x-AnimeSharp",
    "4xNomos2_hq_dat2",
    "4xNomos2_otf_esrgan",
    "4xLSDIRplusC",
    "RealESRGAN_x4plus",
    "RealESRGAN_x4plus_anime_6B",
    "realesrgan-x4minus"
   ],
   "parent": "upscale"
  },
  {
   "key": "upscale_target",
   "label": "Upscale target",
   "type": "select",
   "target": "job",
   "default": "2K",
   "options": [
    "2x",
    "3x",
    "4x",
    "1080p",
    "2K",
    "4K",
    "custom"
   ],
   "parent": "upscale"
  },
  {
   "key": "126:format",
   "label": "Video format",
   "type": "select",
   "target": "node",
   "default": "video/h264-mp4",
   "options": [
    "video/h264-mp4",
    "video/hevc-mp4",
    "video/av1-webm",
    "video/webm",
    "image/gif",
    "image/webp"
   ]
  },
  {
   "key": "126:crf",
   "label": "Video quality (CRF, lower=better)",
   "type": "int",
   "target": "node",
   "default": 20
  }
 ],
 "endpoint_name": "MiniMax H3"
}