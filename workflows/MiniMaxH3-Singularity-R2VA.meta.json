{
 "id": "mmh3-singularity-r2va",
 "name": "MiniMax H3 Singularity R2VA",
 "category": "video",
 "description": "Reference \u2192 video con audio (Singularity fusion, serverless INT8)",
 "handler": "mmh3",
 "remote_file": "MiniMaxH3-Singularity-R2VA.json",
 "endpoint_id": "",
 "outputs": [
  "video",
  "audio"
 ],
 "parameters": [
  {
   "key": "prompt",
   "label": "Prompt",
   "type": "text",
   "target": "job",
   "wildcard_prefix": "vid/"
  },
  {
   "key": "images",
   "label": "Reference images (max 3)",
   "type": "images",
   "target": "job",
   "max": 3
  },
  {
   "key": "video",
   "label": "Reference video (optional)",
   "type": "video",
   "target": "job"
  },
  {
   "key": "lora",
   "label": "Style LoRA",
   "type": "select",
   "target": "job",
   "default": "none",
   "options": [
    "none",
    "realism",
    "char_swap"
   ]
  },
  {
   "key": "seconds",
   "label": "Duration / QwenVL preset",
   "type": "select",
   "target": "job",
   "default": "5",
   "options": [
    "5",
    "10",
    "15"
   ]
  },
  {
   "key": "config",
   "label": "Preset",
   "type": "select",
   "target": "job",
   "default": "r2va_singularity_turbo",
   "options": [
    "native",
    "native_turbo",
    "r2va_singularity",
    "r2va_singularity_turbo",
    "10eros",
    "10eros_turbo"
   ]
  },
  {
   "key": "camera_tag",
   "label": "Camera tag",
   "type": "select",
   "target": "job",
   "default": "None",
   "options": [
    "None",
    "[STATIC_CAMERA]",
    "[LOCKED_OFF]",
    "[SLOW_ZOOM_IN]",
    "[SLOW_ZOOM_OUT]",
    "[FAST_ZOOM_IN]",
    "[FAST_ZOOM_OUT]",
    "[PAN_LEFT]",
    "[PAN_RIGHT]",
    "[TILT_UP]",
    "[TILT_DOWN]",
    "[DOLLY_IN]",
    "[DOLLY_OUT]",
    "[TRACKING_LEFT]",
    "[TRACKING_RIGHT]",
    "[CRANE_UP]",
    "[CRANE_DOWN]",
    "[ORBIT]",
    "[HANDHELD]",
    "[ROLL]"
   ]
  },
  {
   "key": "enhance",
   "label": "Enhancer QwenVL",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "vl_preset",
   "label": "Enhancer preset",
   "type": "select",
   "target": "job",
   "default": "MiniMax \u203a NSFW R2VA",
   "options": [
    "MiniMax \u203a NSFW R2VA",
    "MiniMax \u203a SFW R2VA"
   ],
   "parent": "enhance"
  },
  {
   "key": "220:aspect_ratio",
   "label": "Aspect ratio",
   "type": "select",
   "target": "node",
   "default": "3:4",
   "options": [
    "16:9",
    "4:3",
    "1:1",
    "3:4",
    "9:16",
    "21:9"
   ]
  },
  {
   "key": "220:resolution",
   "label": "Resolution",
   "type": "select",
   "target": "node",
   "default": "Native",
   "options": [
    "Fast Draft",
    "Preview",
    "High Detail",
    "Native",
    "1.5K",
    "1080P Class",
    "2K"
   ]
  },
  {
   "key": "upscale",
   "label": "Upscale",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "rife",
   "label": "RIFE 48fps (post)",
   "type": "bool",
   "target": "job",
   "default": true
  },
  {
   "key": "upscale_model",
   "label": "Upscale model",
   "type": "select",
   "target": "job",
   "default": "2xLexicaRRDBNet",
   "options": [
    "2x-CGIMaster-v1",
    "2x-AnimeSharpV3",
    "2xLexicaRRDBNet",
    "2xLexicaRRDBNet_Sharp",
    "RealESRGAN_x2plus",
    "4xUltrasharp_4xUltrasharpV10",
    "4x-AnimeSharp",
    "4xNomos2_hq_dat2",
    "4xNomos2_otf_esrgan",
    "4xLSDIRplusC",
    "RealESRGAN_x4plus",
    "RealESRGAN_x4plus_anime_6B",
    "realesrgan-x4minus"
   ],
   "parent": "upscale"
  },
  {
   "key": "upscale_target",
   "label": "Upscale target",
   "type": "select",
   "target": "job",
   "default": "2K",
   "options": [
    "2x",
    "3x",
    "4x",
    "1080p",
    "2K",
    "4K",
    "custom"
   ],
   "parent": "upscale"
  },
  {
   "key": "126:format",
   "label": "Video format",
   "type": "select",
   "target": "node",
   "default": "video/h264-mp4",
   "options": [
    "video/h264-mp4",
    "video/hevc-mp4",
    "video/av1-webm",
    "video/webm",
    "image/gif",
    "image/webp"
   ]
  },
  {
   "key": "126:crf",
   "label": "Video quality (CRF, lower=better)",
   "type": "int",
   "target": "node",
   "default": 20
  }
 ],
 "endpoint_name": "MiniMax H3"
}
