{
  "id": "flux-dev-t2i",
  "name": "Flux Dev T2I",
  "category": "RunPod Cloud",
  "description": "FLUX flagship quality generation (RunPod Public Endpoint, $0.02/MP)",
  "endpoint_id": "black-forest-labs-flux-1-dev",
  "public_endpoint": true,
  "outputs": [
    "image"
  ],
  "parameters": [
    {
      "key": "prompt",
      "label": "Prompt",
      "type": "text",
      "target": "job"
    },
    {
      "key": "image_size",
      "label": "Image size",
      "type": "select",
      "target": "job",
      "splits": [
        "width",
        "height"
      ],
      "default": "1024x1024 (1:1)",
      "options": [
        "1024x1024 (1:1)",
        "1152x896 (4:3)",
        "896x1152 (3:4)",
        "1216x832 (3:2)",
        "832x1216 (2:3)",
        "1344x768 (16:9)",
        "768x1344 (9:16)",
        "1536x640 (21:9)",
        "640x1536 (9:21)"
      ]
    },
    {
      "key": "num_inference_steps",
      "label": "Steps (1-50)",
      "type": "int",
      "target": "job",
      "default": 28
    },
    {
      "key": "guidance",
      "label": "Guidance",
      "type": "float",
      "target": "job",
      "default": 3.5
    },
    {
      "key": "seed",
      "label": "Seed (-1 = random)",
      "type": "int",
      "target": "job",
      "default": -1
    },
    {
      "key": "image_format",
      "label": "Format",
      "type": "select",
      "target": "job",
      "default": "png",
      "options": [
        "png",
        "jpeg"
      ]
    }
  ],
  "price_hint": "$0.02/megapixel",
  "order": 12
}