{
  "name": "forgehub-app",
  "version": "0.1.10",
  "private": true,
  "description": "Desktop app for ComfyUI workflows on Runpod Serverless",
  "author": "huchukato",
  "homepage": "https://github.com/huchukato/ForgeHub",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "icon": "mkdir -p icons && iconutil -c icns ../img/icon.iconset -o icons/icon.icns",
    "electron:dev": "cross-env NODE_ENV=development electron dist-electron/electron/main.js",
    "backend:bundle": "cd .. && uv run --with pyinstaller pyinstaller packaging/backend_entry.py --name forgehub-backend --onefile --noconfirm --distpath backend-dist --workpath backend-build --paths . --collect-submodules uvicorn --collect-data certifi --collect-binaries imageio_ffmpeg",
    "electron:build": "npm run build && npm run icon && npm run backend:bundle && electron-builder"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.51.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.huchukato.forgehub",
    "productName": "ForgeHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "splash.html"
    ],
    "extraResources": [
      {
        "from": "../backend-dist",
        "to": "."
      },
      {
        "from": "../workflows",
        "to": "workflows"
      },
      {
        "from": "../wildcards",
        "to": "wildcards"
      }
    ],
    "mac": {
      "icon": "icons/icon.icns",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "huchukato <noreply@github.com>"
    }
  }
}
